NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/trips
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/trips

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
