# Clerk Authentication
# Create an application at https://dashboard.clerk.com
# Enable Google OAuth as the primary sign-in method in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
